sayi1 = int(input("1. sayıyı giriniz: "))
sayi2 = int(input("2. sayıyı giriniz: "))
işlem = input("işleminiz nedir (+,-,*,/)? ")

if işlem == "+":
  toplam = sayi1+sayi2
  print(f"{sayi1} + {sayi2} = {toplam}")
if işlem == "-":
  fark = sayi1-sayi2
  print(f"{sayi1} - {sayi2} = {fark}")
if işlem == "*":
  çarpım = sayi1*sayi2
  print(f"{sayi1} * {sayi2} = {çarpım}")
if işlem == "/":
  bölüm = sayi1/sayi2
  print(f"{sayi1} / {sayi2} = {bölüm}")
